# Generate every secret with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
AUTHENTIK_ADMIN_PASS=
METAMCP_PG_PASS=
METAMCP_AUTH_SECRET=
METAMCP_ADMIN_PASS=
# Per-vault MCP bearer tokens (known only to MetaMCP)
MCP_TOKEN_ANNA=
MCP_TOKEN_BEN=
MCP_TOKEN_FIRMA=
MCP_READONLY_TOKEN_FIRMA=
# Per-vault proxy secrets (known only to Traefik + the vault)
PROXY_SECRET_ANNA=
PROXY_SECRET_BEN=
PROXY_SECRET_FIRMA=
# Per-vault tokens for the shared embedding service (LBV2-26); then run ./embed-tokens.sh,
# which adds EMBED_TOKEN_SHA256_<VAULT> (the only form the embed service sees)
EMBED_TOKEN_ANNA=
EMBED_TOKEN_BEN=
EMBED_TOKEN_FIRMA=
# Demo user passwords (local prototype only)
DEMO_PASS_ANNA=
DEMO_PASS_BEN=
DEMO_PASS_CARL=
# Compose project name (default lokyy-stack)
# STACK_NAME=lokyy-stack
# Second stack next to a running one (tests): other host port, other /16 for all subnets, other image tag
# STACK_HTTP_PORT=18080
# STACK_NET=10.231
# IMAGE_TAG=dev
# Memory limits (measured, see README "Memory"): shared embedding service and each vault
# EMBED_MEM_LIMIT=3584m
# VAULT_MEM_LIMIT=1g
# LLM via EUrouter (LBV2-5, llm/configure-eurouter.sh) — supplied by Oliver, not generated:
# EUROUTER_API_KEY=
# EUROUTER_MODEL=
# EUROUTER_API_KEY_ANNA=   # optional per-vault key (overrides EUROUTER_API_KEY for vault anna)
# Vaults may only call these LLM hosts (VAULT_LLM_ALLOWED_HOSTS in compose.yml, LBV2-19): api.eurouter.ai
